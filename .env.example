# Checkpoint configuration. Copy to .env (setup.ps1 does this). All values optional.
# Secrets (the shared workspace token) are NOT stored here - the desktop keeps them in
# Windows Credential Manager.

# Where the database, screenshots, audio and models live (default: %LOCALAPPDATA%\Checkpoint).
# CHECKPOINT_DATA_DIR=D:\CheckpointData

# Local UI port on 127.0.0.1 (a free port nearby is used if taken).
# CHECKPOINT_PORT=8765

# Development only: allow the Vite dev server origin (http://127.0.0.1:5173).
# CHECKPOINT_DEV=1

# ---------------------------------------------------------------------------
# Shared server (only on the machine running `python -m checkpoint_server`, see docs/shared-server.md)
# CHECKPOINT_SERVER_DATABASE_URL=postgresql+psycopg://checkpoint:CHANGE_ME@localhost:5432/checkpoint
# CHECKPOINT_SERVER_TOKEN=generate-with-python-m-checkpoint_server.gentoken
# CHECKPOINT_SERVER_MEDIA_DIR=/var/lib/checkpoint/media
# CHECKPOINT_SERVER_WORKSPACE_NAME=Our team
# CHECKPOINT_SERVER_MAX_UPLOAD_MB=20
# CHECKPOINT_SERVER_HOST=127.0.0.1
# CHECKPOINT_SERVER_PORT=8780
